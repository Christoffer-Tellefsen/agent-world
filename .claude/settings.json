{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": ".claude/hooks/ledger.sh session_start" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": ".claude/hooks/ledger.sh run_started" } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": ".claude/hooks/ledger.sh gate_waiting" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": ".claude/hooks/ledger.sh gate_passed" } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": ".claude/hooks/ledger.sh gate_passed" } ] }
    ],
    "SessionEnd": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": ".claude/hooks/ledger.sh run_completed", "timeout": 10 } ] }
    ]
  }
}
